# Copia este archivo a .env y ajusta los valores
DB_NAME=menudb
DB_USERNAME=app
DB_PASSWORD=app
DB_PORT=5433

BACKEND_PORT=8080
FRONTEND_PORT=80

CORS_ALLOWED_ORIGINS=http://localhost

# URL pública del frontend: es la que se codifica en los QR de las mesas.
# Para probar desde el móvil en la misma wifi, pon la IP de tu ordenador (p. ej. http://192.168.1.50)
APP_PUBLIC_URL=http://localhost

# Carga una carta y 8 mesas de ejemplo si la base de datos está vacía
DEMO_DATA=true

# Administrador del panel (se crea al arrancar si no existe)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia-esta-contraseña

# Secreto para firmar los JWT: al menos 32 caracteres aleatorios (p. ej. `openssl rand -base64 48`)
JWT_SECRET=
